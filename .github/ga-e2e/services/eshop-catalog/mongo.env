# The mongo arm: the replica set of backends/mongo.yaml, a database per service (operate/mongodb.md). The eShop's
# servers have no mongo profile and no wow-mongo yet (finding F1), so this arm's nodes do not start until they do.
SPRING_PROFILES_ACTIVE=mongo
WOW_BACKEND=mongo
SPRING_MONGODB_URI=mongodb://mongo-0.mongo:27017,mongo-1.mongo:27017,mongo-2.mongo:27017/?replicaSet=rs0
WOW_MONGO_DATABASE=eshop_catalog
