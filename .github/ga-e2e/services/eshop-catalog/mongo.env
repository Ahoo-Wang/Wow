# The mongo arm: the server's mongo profile on the replica set of backends/mongo.yaml (its database is the profile's).
# The host creates the client from the URI once D318 lands (R5 batch 4); until then ga-e2e.yml leaves this arm out.
SPRING_PROFILES_ACTIVE=mongo,cosec
SPRING_MONGODB_URI=mongodb://mongo-0.mongo:27017,mongo-1.mongo:27017,mongo-2.mongo:27017/?replicaSet=rs0
