# The mongo arm (operate/mongodb.md). The ordering server has no mongo profile and no wow-mongo yet (finding F1).
SPRING_PROFILES_ACTIVE=mongo,kafka,clickhouse
WOW_BACKEND=mongo
SPRING_MONGODB_URI=mongodb://mongo-0.mongo:27017,mongo-1.mongo:27017,mongo-2.mongo:27017/?replicaSet=rs0
WOW_MONGO_DATABASE=eshop_ordering
