{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wow.ahoo.me/schemas/wow-skill-eval-trace-v2.json",
  "title": "Wow Skill evaluation adapter evidence",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "requestSha256",
    "adapter",
    "output",
    "processExitCode",
    "events",
    "sandbox",
    "attestation"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "requestSha256": {
      "type": "string",
      "description": "SHA-256 of the exact UTF-8 file bytes stored in request.json, including formatting whitespace and the trailing newline.",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter": {
      "type": "object",
      "required": [
        "name",
        "version",
        "capabilities",
        "freshTask",
        "promptExact"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "activation-trace",
              "tool-trace",
              "command-policy",
              "workspace-policy",
              "activation-only"
            ]
          }
        },
        "freshTask": {
          "const": true
        },
        "promptExact": {
          "const": true
        }
      }
    },
    "output": {
      "type": "string"
    },
    "processExitCode": {
      "type": "integer"
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/activationEvent"
          },
          {
            "$ref": "#/$defs/accessEvent"
          },
          {
            "$ref": "#/$defs/commandEvent"
          }
        ]
      }
    },
    "sandbox": {
      "$ref": "#/$defs/sandbox"
    },
    "attestation": {
      "$ref": "#/$defs/attestation"
    }
  },
  "$defs": {
    "activationEvent": {
      "type": "object",
      "required": ["seq", "type", "skill", "primary"],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "activation"
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "primary": {
          "type": "boolean"
        }
      }
    },
    "accessEvent": {
      "type": "object",
      "required": ["seq", "type", "path"],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "enum": ["read", "write"]
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "commandEvent": {
      "type": "object",
      "required": ["seq", "type", "argv", "cwd", "executable", "exitCode"],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "const": "command"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string"
        },
        "executable": {
          "type": "string",
          "pattern": "^/"
        },
        "exitCode": {
          "type": "integer"
        }
      }
    },
    "sandbox": {
      "type": "object",
      "required": [
        "externalReadBlocked",
        "externalMutationBlocked",
        "networkBlocked",
        "connectorsBlocked",
        "evalContentBlocked",
        "activationOnly",
        "commandPolicyEnforced"
      ],
      "additionalProperties": false,
      "properties": {
        "externalReadBlocked": {
          "type": "boolean"
        },
        "externalMutationBlocked": {
          "const": true
        },
        "networkBlocked": {
          "const": true
        },
        "connectorsBlocked": {
          "const": true
        },
        "evalContentBlocked": {
          "const": true
        },
        "activationOnly": {
          "type": "boolean"
        },
        "commandPolicyEnforced": {
          "const": true
        }
      }
    },
    "attestation": {
      "type": "object",
      "required": ["algorithm", "keyId", "signature"],
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "hmac-sha256"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
