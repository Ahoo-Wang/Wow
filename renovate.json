{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "baseBranchPatterns": ["main"],
  "timezone": "Asia/Shanghai",
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "groupName": null,
    "schedule": [],
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": null
  },
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "commitMessageTopic": "{{depName}}",
  "rangeStrategy": "bump",
  "minimumReleaseAge": "12 hours",
  "prHourlyLimit": 10,
  "prConcurrentLimit": 20,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 3pm on the first day of the month"
    ],
    "commitMessageTopic": "lock files",
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Tool versions pinned in workflows next to a `# renovate: datasource=… depName=…` comment, such as the npm CLI that publishes to npm.",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+: (?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Require manual approval for major version updates.",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Create major updates for first-party Ahoo-Wang packages without dashboard approval.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@ahoo-wang\\//"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "description": "Hold npm updates for 24 hours so Renovate's pnpm-12 artifact updates never see sub-24h lockfile entries.",
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "24 hours"
    },
    {
      "description": "Group GitHub Actions updates. Actions pinned by commit SHA with a `# vX.Y.Z` comment get the SHA and the comment updated together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "commitMessageTopic": "GitHub Actions"
    },
    {
      "description": "Group Spring Boot, Spring Framework, and Springdoc updates.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "/^org\\.springframework[.:]/",
        "/^org\\.springdoc:/"
      ],
      "groupName": "spring",
      "commitMessageTopic": "Spring ecosystem"
    },
    {
      "description": "Group Kotlin compiler, Kotlin plugins, KSP, and Kotlin compile-testing updates.",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin([.:]|$)/",
        "/^com\\.google\\.devtools\\.ksp([.:]|$)/",
        "dev.zacsweers.kctfork:ksp"
      ],
      "groupName": "kotlin",
      "commitMessageTopic": "Kotlin toolchain"
    },
    {
      "description": "Group OpenTelemetry core and instrumentation BOMs so API/SDK and instrumentation stay aligned.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "io.opentelemetry:opentelemetry-bom",
        "io.opentelemetry.instrumentation:opentelemetry-instrumentation-bom"
      ],
      "groupName": "opentelemetry",
      "commitMessageTopic": "OpenTelemetry BOMs"
    },
    {
      "description": "Group Ahoo platform BOM updates used by wow-dependencies.",
      "matchDatasources": [
        "maven"
      ],
      "matchPackageNames": [
        "me.ahoo.cosid:cosid-bom"
      ],
      "groupName": "ahoo-platform-boms",
      "commitMessageTopic": "Ahoo platform BOMs"
    },
    {
      "description": "Group Ahoo Fetcher packages because the generated clients and the published packages use them as one version family.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@ahoo-wang\\/fetcher/"
      ],
      "groupName": "fetcher",
      "commitMessageTopic": "Fetcher packages"
    },
    {
      "description": "Group React runtime packages used by the workspace packages and apps.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "react-router"
      ],
      "groupName": "react",
      "commitMessageTopic": "React ecosystem"
    },
    {
      "description": "Group Vite and Vitest tooling used across the pnpm workspace.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "vitest",
        "@vitest/coverage-v8",
        "@vitest/ui",
        "vitest-browser-react",
        "vite-bundle-analyzer"
      ],
      "groupName": "vite-vitest",
      "commitMessageTopic": "Vite and Vitest"
    },
    {
      "description": "Group VitePress documentation tooling.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "vitepress",
        "vitepress-plugin-llms",
        "vitepress-plugin-mermaid",
        "mermaid"
      ],
      "groupName": "vitepress",
      "commitMessageTopic": "VitePress documentation"
    },
    {
      "description": "One weekly pull request for every non-major npm update, so the many pnpm-lock.yaml edits land together instead of conflicting and each re-running CI. Majors keep their own pull requests (and the dashboard approval above), peer ranges keep their own rule below, and security updates (vulnerabilityAlerts) ignore the group and the schedule. The window is the whole of Monday because the Renovate workflow runs at 02:17 UTC, which is 10:17 in the timezone above.",
      "matchDatasources": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "matchDepTypes": [
        "!pnpm.catalog.peers"
      ],
      "groupName": "npm non-major",
      "commitMessageTopic": "npm non-major dependencies",
      "schedule": [
        "on monday"
      ]
    },
    {
      "description": "Peer ranges of the published npm packages (the `peers` catalog in pnpm-workspace.yaml) are a published contract. Only widen them, never raise a lower bound, and only after dashboard approval; the default catalog keeps the versions CI tests against current.",
      "matchDepTypes": [
        "pnpm.catalog.peers"
      ],
      "rangeStrategy": "widen",
      "dependencyDashboardApproval": true,
      "groupName": "npm peer ranges",
      "commitMessageTopic": "npm peer ranges"
    },
    {
      "description": "Leave `engines` alone: the published packages' Node range (`>=22.12.0`, R3-05) is a compatibility promise changed on purpose, not by a dependency bump. Node itself is still updated where it is a tool version (workflows, `.nvmrc`).",
      "matchDepTypes": [
        "engines"
      ],
      "enabled": false
    }
  ]
}
