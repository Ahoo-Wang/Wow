{
  "format": 1,
  "contexts": [
    {
      "name": "inventory",
      "aggregates": [
        {
          "name": "stock",
          "state": { "schema": "#/$defs/sample.inventory.StockState" },
          "commands": [
            { "name": "ReserveStock", "schema": "#/$defs/sample.inventory.ReserveStock", "creation": "none" },
            { "name": "CreateStock", "schema": "#/$defs/sample.inventory.CreateStock", "creation": "required" }
          ],
          "events": [{ "name": "StockReserved", "revision": 1, "schema": "#/$defs/sample.inventory.StockReserved" }]
        },
        {
          "name": "bin",
          "state": { "schema": "#/$defs/sample.inventory.BinState" },
          "snapshot": { "enabled": false }
        },
        {
          "name": "ledger",
          "state": { "schema": "#/$defs/sample.inventory.LedgerState" }
        }
      ],
      "subscriptions": [
        {
          "name": "StockProjector.onStock",
          "kind": "projection",
          "source": { "context": "inventory", "aggregates": ["stock"] },
          "function": { "kind": "project", "context": "inventory", "processor": "StockProjector", "name": "onStock" },
          "start": "beginning"
        },
        {
          "name": "RestockSaga.onReserved",
          "kind": "saga",
          "source": { "context": "inventory" },
          "function": { "kind": "saga", "context": "inventory", "processor": "RestockSaga", "name": "onReserved" },
          "derives": ["inventory.stock.CreateStock"],
          "start": "end"
        },
        {
          "name": "RestockSaga.onRejected",
          "kind": "saga",
          "source": {},
          "function": { "kind": "saga", "context": "inventory", "processor": "RestockSaga", "name": "onRejected" },
          "derives": [],
          "rejected": []
        },
        {
          "name": "BinWatcher.onBin",
          "kind": "reactor",
          "source": { "context": "inventory", "aggregates": ["bin"] },
          "function": { "kind": "react", "context": "inventory", "processor": "BinWatcher", "name": "onBin" },
          "start": "end"
        }
      ],
      "published": [
        { "aggregate": "stock", "topic": "wow.inventory.stock.state", "includeState": true },
        { "aggregate": "bin", "topic": "inventory-bins", "includeState": false }
      ]
    }
  ],
  "$defs": {
    "sample.inventory.ReserveStock": { "type": "object" }
  }
}
