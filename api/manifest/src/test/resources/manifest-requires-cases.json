{
  "description": "Manifests that require a marker no reader understands yet, and what each reader refuses them for. Every Manifest reader holds to this table: ManifestTree.read (ManifestRequiresCasesTest), @ahoo-wang/wow-client's checkManifest and @ahoo-wang/wow-generator's validateManifest. Each refusal names the level and the node, and the markers sorted and distinct; the first marker the walk meets (the Manifest's, then each context in order, its own before its aggregates') is the one refused.",
  "cases": [
    {
      "name": "the Manifest",
      "manifest": { "format": 1, "requires": ["x"], "contexts": [] },
      "refused": "Manifest requires x"
    },
    {
      "name": "a context",
      "manifest": {
        "format": 1,
        "contexts": [{ "name": "shop", "requires": ["x"], "aggregates": [] }]
      },
      "refused": "context shop requires x"
    },
    {
      "name": "an aggregate",
      "manifest": {
        "format": 1,
        "contexts": [
          {
            "name": "shop",
            "aggregates": [{ "name": "cart", "requires": ["x"] }]
          }
        ]
      },
      "refused": "aggregate shop.cart requires x"
    },
    {
      "name": "an aggregate's markers, sorted and distinct",
      "manifest": {
        "format": 1,
        "contexts": [
          {
            "name": "shop",
            "aggregates": [{ "name": "cart", "requires": ["y", "x", "y"] }]
          }
        ]
      },
      "refused": "aggregate shop.cart requires x, y"
    },
    {
      "name": "a context before its aggregate",
      "manifest": {
        "format": 1,
        "contexts": [
          {
            "name": "shop",
            "requires": ["a"],
            "aggregates": [{ "name": "cart", "requires": ["b"] }]
          }
        ]
      },
      "refused": "context shop requires a"
    },
    {
      "name": "the Manifest before its contexts",
      "manifest": {
        "format": 1,
        "requires": ["a"],
        "contexts": [{ "name": "shop", "requires": ["b"], "aggregates": [] }]
      },
      "refused": "Manifest requires a"
    },
    {
      "name": "an aggregate of a later context",
      "manifest": {
        "format": 1,
        "contexts": [
          { "name": "billing", "aggregates": [] },
          {
            "name": "shop",
            "aggregates": [{ "name": "cart", "requires": ["x"] }]
          }
        ]
      },
      "refused": "aggregate shop.cart requires x"
    }
  ]
}
