+    @Test
+    fun `a batch commits without waiting for its WAL, and the connection keeps its own setting`(): Unit = runBlocking {
+        // Roadmap §6 item 9: snapshots are derived from the log, so their batch need not wait for the flush.
+        val pool = PostgresFixture.dataSource
+        val single = HikariDataSource(
+            HikariConfig().apply {
+                jdbcUrl = pool.jdbcUrl
+                username = pool.username
+                password = pool.password
+                maximumPoolSize = 1
+            },
+        )
+        single.use { target ->
+            val atCommit = ArrayList<String>()
+            val observed = committing(target) { connection -> atCommit += settingOf(connection) }
+            val context = PostgresFixture.newContext()
+            val store = PostgresSnapshotStore(observed, context)
+            val type = AggregateType(context, "order")
+            // The first use creates the table, in a transaction of its own.
+            store.save(snapshot("o0", 1).copyWith(ref = type.ref("tenant", "o0"))).assert().isTrue()
+            atCommit.clear()
+            store.saveAll((1..3).map { snapshot("o$it", 1).copyWith(ref = type.ref("tenant", "o$it")) })
+                .forEach { it.assert().isEqualTo(SnapshotSaveOutcome.Written) }
+            atCommit.assert().containsExactly("off")
+            // SET LOCAL ends with the transaction: the pool's one connection is back to the server's setting.
+            target.connection.use { settingOf(it) }.assert().isEqualTo("on")
+        }
+    }
+
+    /** [target] whose connections run [beforeCommit] on themselves just before each commit. */
+    private fun committing(target: DataSource, beforeCommit: (Connection) -> Unit): DataSource =
+        Proxy.newProxyInstance(DataSource::class.java.classLoader, arrayOf(DataSource::class.java)) { _, method, args ->
+            val result = invoke(method, target, args)
+            if (method.name != "getConnection") return@newProxyInstance result
+            val connection = result as Connection
+            Proxy.newProxyInstance(Connection::class.java.classLoader, arrayOf(Connection::class.java)) { _, call, callArgs ->
+                if (call.name == "commit") beforeCommit(connection)
+                invoke(call, connection, callArgs)
+            }
+        } as DataSource
+
+    private fun invoke(method: Method, target: Any, args: Array<out Any?>?): Any? = try {
+        method.invoke(target, *(args ?: emptyArray()))
+    } catch (failure: InvocationTargetException) {
+        throw failure.targetException
+    }
+
+    private fun settingOf(connection: Connection): String = connection.createStatement().use { statement ->
+        statement.executeQuery("SELECT current_setting('synchronous_commit')").use { rows ->
+            rows.next()
+            rows.getString(1)
+        }
+    }
