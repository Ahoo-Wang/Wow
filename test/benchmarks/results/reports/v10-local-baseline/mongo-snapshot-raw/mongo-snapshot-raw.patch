+import org.junit.jupiter.api.Test
+
+class MongoOperatorsTest {
+    /** Reads the field `operator` of [document] with [MongoOperators.of], as a snapshot's load does. */
+    private fun read(document: Document): Operator? =
+        BsonBinaryReader(RawBsonDocument(document, DocumentCodec()).byteBuffer.asNIO()).use { reader ->
+            reader.readStartDocument()
+            reader.readBsonType()
+            reader.readName()
+            MongoOperators.of(reader)
+        }
+
+    @Test
+    fun `an operator reads back as its document reads`() {
+        val operator = Operator("bob", "tenant", crossScope = true)
+        val stored = Document("operator", MongoOperators.document(operator))
+        read(stored).assert().isEqualTo(MongoOperators.of(MongoOperators.document(operator)))
+        read(stored)?.crossScope.assert().isEqualTo(true)
+    }
+
+    @Test
+    fun `a null operator is none, and a field it does not know is skipped`() {
+        read(Document("operator", null)).assert().isNull()
+        val operator = Document("id", "bob").append("extra", Document("x", 1)).append("tenantId", "t")
+        val stored = Document("operator", operator)
+        read(stored).assert().isEqualTo(Operator("bob", "t"))
+        read(stored)?.crossScope.assert().isEqualTo(false)
+    }
+
+    @Test
+    fun `an operator without its id or tenant is refused`() {
+        assertThrownBy<IllegalStateException> { read(Document("operator", Document("tenantId", "t"))) }
+        assertThrownBy<IllegalStateException> { read(Document("operator", Document("id", "bob"))) }
+    }
+}
