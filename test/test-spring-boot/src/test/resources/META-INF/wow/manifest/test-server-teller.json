{
  "format" : 1,
  "contexts" : [
    {
      "name" : "teller",
      "description" : "The test server's second context: a teller's tills, beside the quickstart's bank",
      "aggregates" : [
        {
          "name" : "till",
          "state" : {
            "schema" : "#/$defs/me.ahoo.wow.test.server.Till"
          },
