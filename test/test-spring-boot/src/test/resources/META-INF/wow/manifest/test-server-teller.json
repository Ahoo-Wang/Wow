        }
      }
    },
    "me.ahoo.wow.test.server.OpenTill" : {
      "type" : "object",
      "properties" : {
        "teller" : {
          "type" : "string"
        }
      }
    },
    "me.ahoo.wow.test.server.TillOpened" : {
      "type" : "object",
      "properties" : {
        "teller" : {
          "type" : "string"
        }
      }
    }
  }
