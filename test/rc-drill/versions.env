# The third-party pieces of the rc drill's platform, pinned: the drill installs these and nothing newer. Wow's own
# artifacts are not here: the drill takes them by the release's version (DRILL_VERSION), from the registries a release
# publishes to. Images the manifests name carry their pin in the manifest (by digest, as .github/ga-e2e/ does).

# The cluster: kind and its CNI. Calico enforces NetworkPolicy, which kind's own kindnet does not.
KIND_VERSION=v0.33.0
# The tools on the machine the drill was checked against (README.md, "Tools"); `drill.sh tools` refuses others.
HELM_VERSION=v4.3.1
# kubectl within one minor version of the nodes' Kubernetes, 1.37.
KUBECTL_MINORS="36 37 38"
# The JDK the build runs on: the repository's toolchain, as CI's (the images run their own, 25).
JDK_MAJOR=21
# The image kind.yaml's nodes run: kind v0.33.0's own, Kubernetes 1.37.0.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
CALICO_VERSION=v3.32.2
CALICO_SHA256=a8c828a06a87c629a282ebbc424895b77f3a030251993e41ea400a743675bb02

# The edge: Traefik as the ingress controller in front of the CoSec gateway (platform/ingress/).
TRAEFIK_CHART_VERSION=42.1.3

# Telemetry: the OpenTelemetry Operator injects the Java agent into every Wow pod (the services' values carry the
# operator's annotation), as deploy/ expects; the agent's image is the Instrumentation's
# (platform/observability/instrumentation.yaml).
OTEL_OPERATOR_CHART_VERSION=0.126.2
