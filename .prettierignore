# Prettier owns the TypeScript toolchain only. Kotlin, Gradle, Markdown and YAML
# elsewhere in the repository, the V10 apps (double quotes) and the
# documentation site (four-space indent) keep their own styles, so everything is
# ignored except the paths re-included below.
/*
!/typescript/
!/package.json
!/pnpm-workspace.yaml
!/tsconfig.base.json
!/eslint.config.js
!/.prettierrc
!/.github/
/.github/*
!/.github/scripts/
/.github/scripts/*
!/.github/scripts/*.mjs
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/typescript*.yml

node_modules/
dist/
coverage/

# Byte-for-byte generator snapshots, compared against ts-morph's own output by
# the e2e test; reformatting them would fail every regeneration.
typescript/wow-generator/expected/
# Generated from the V10 view store's Manifest baseline, held byte for byte by
# typescript/wow-view-store/test/v10/generated.test.ts.
typescript/wow-view-store/src/v10/generated/
test-output/
# Baselines tests write and compare byte for byte: API Extractor's reports and
# the golden files wow-client's tests write with -u.
typescript/wow-client/test/api/
typescript/wow-view-store/test/api/
typescript/wow-view-engine/test/api/
typescript/wow-client/test/golden/
# Fixed copies of 9.x sources and snapshots the TypeScript tests read (decision D262), byte for byte.
typescript/*/test/fixtures/nine-x/

# Vendored from the shadcn registry and updated with `shadcn add --diff`;
# reformatting them turns every future update into a whole-file diff.
typescript/wow-view-engine/src/ui/components/
typescript/wow-view-engine/src/ui/lib/
storybook-static/
