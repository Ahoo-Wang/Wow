{
  "format" : 1,
  "contexts" : [ {
    "name" : "bank",
    "description" : "The host's test context: accounts",
    "aggregates" : [ {
      "name" : "account",
      "state" : {
        "schema" : "#/$defs/Account"
      },
      "snapshot" : {
        "enabled" : true
      },
      "commands" : [ {
        "name" : "Deposit",
        "aliases" : [ ],
        "schema" : "#/$defs/Deposit",
        "creation" : "none",
        "routes" : [ {
          "method" : "POST",
          "path" : "/bank/account/{id}/deposit"
        } ]
      }, {
        "name" : "OpenAccount",
        "aliases" : [ ],
        "schema" : "#/$defs/OpenAccount",
        "creation" : "required",
        "routes" : [ {
          "method" : "POST",
          "path" : "/bank/account/{id}/open-account"
        }, {
          "method" : "POST",
          "path" : "/bank/account/open-account"
        } ]
      } ],
      "events" : [ {
        "name" : "AccountOpened",
        "aliases" : [ ],
        "revision" : 1,
        "schema" : "#/$defs/AccountOpened"
      }, {
        "name" : "Deposited",
        "aliases" : [ ],
        "revision" : 1,
        "schema" : "#/$defs/Deposited"
      } ],
      "lifecycle" : [ ],
      "queries" : [ {
        "model" : "snapshot",
        "routes" : [ {
          "method" : "POST",
          "path" : "/bank/account/snapshot/query"
        }, {
          "method" : "GET",
          "path" : "/bank/account/snapshot/query"
        } ]
      }, {
        "model" : "events",
        "routes" : [ {
          "method" : "POST",
          "path" : "/bank/account/events/query"
        }, {
          "method" : "GET",
          "path" : "/bank/account/events/query"
        } ]
      } ]
    } ],
    "subscriptions" : [ ],
    "errors" : [ {
      "code" : "bank.account.frozen",
      "status" : 423,
      "description" : "The account takes no deposit."
    } ]
  } ],
  "errors" : [ ],
  "$defs" : {
    "Account" : {
      "type" : "object",
      "properties" : {
        "owner" : {
          "type" : "string"
        },
        "balance" : {
          "type" : "integer",
          "format" : "int64"
        }
      },
      "x-wow-index" : [ {
        "name" : "ix_account_owner",
        "keys" : [ "state.owner" ]
      } ]
    }
  }
}
