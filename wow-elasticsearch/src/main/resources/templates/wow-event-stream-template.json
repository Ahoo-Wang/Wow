{
  "index_patterns": [
    "wow.*.es"
  ],
  "template": {
    "mappings": {
      "_meta": {
        "wow_query_presence_version": 1
      },
      "properties": {
        "aggregateId": {
          "type": "keyword"
        },
        "aggregateName": {
          "type": "keyword"
        },
        "body": {
          "properties": {
            "bodyType": {
              "type": "keyword"
            },
            "id": {
                "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "revision": {
              "type": "keyword"
            }
          }
        },
        "commandId": {
          "type": "keyword"
        },
        "contextName": {
          "type": "keyword"
        },
        "createTime": {
          "type": "long"
        },
        "header": {
          "properties": {
            "upstream_id": {
              "type": "keyword"
            },
            "upstream_name": {
              "type": "keyword"
            }
          }
        },
        "id": {
          "type": "keyword"
        },
        "requestId": {
          "type": "keyword"
        },
        "tenantId": {
          "type": "keyword"
        },
        "ownerId": {
          "type": "keyword"
        },
        "spaceId": {
          "type": "keyword"
        },
        "version": {
          "type": "integer"
        }
      },
      "dynamic_templates": [
        {
          "wow_query_present_keyword": {
            "match_mapping_type": "string",
            "path_match": [
              "__wow_query.present",
              "*.__wow_query.present"
            ],
            "mapping": {
              "type": "keyword",
              "index": true,
              "doc_values": true
            }
          }
        },
        {
          "wow_query_null_keyword": {
            "match_mapping_type": "string",
            "path_match": [
              "__wow_query.null",
              "*.__wow_query.null"
            ],
            "mapping": {
              "type": "keyword",
              "index": true,
              "doc_values": true
            }
          }
        },
        {
          "string_as_keyword": {
            "match_mapping_type": "string",
            "mapping": {
              "type": "keyword"
            }
          }
        }
      ]
    }
  }
}
