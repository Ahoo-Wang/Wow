{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "definitions" : {
    "example.cart.CartItem" : {
      "type" : "object",
      "properties" : {
        "productId" : {
          "type" : "string"
        },
        "quantity" : {
          "type" : "integer",
          "format" : "int32"
        }
      },
      "required" : [ "productId" ]
    }
  },
  "type" : "object",
  "properties" : {
    "id" : {
      "type" : "string"
    },
    "items" : {
      "type" : "array",
      "items" : {
        "$ref" : "#/definitions/example.cart.CartItem"
      }
    },
    "size" : {
      "readOnly" : true,
      "type" : "integer",
      "format" : "int32",
      "description" : "购物车数量"
    }
  },
  "required" : [ "id" ]
}
