{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "definitions" : {
    "wow.schema.TestAddress" : {
      "type" : "object",
      "properties" : {
        "city" : {
          "type" : "string"
        },
        "country" : {
          "type" : "string"
        },
        "district" : {
          "type" : "string"
        }
      }
    },
    "wow.schema.TestItem" : {
      "type" : "object",
      "properties" : {
        "price" : {
          "type" : "number"
        },
        "productId" : {
          "type" : "string"
        },
        "quantity" : {
          "type" : "integer",
          "format" : "int32"
        }
      },
      "required" : [ "price", "productId", "quantity" ]
    },
    "wow.schema.TestStatus" : {
      "type" : "string",
      "enum" : [ "ACTIVE", "INACTIVE" ]
    }
  },
  "type" : "object",
  "properties" : {
    "contextName" : {
      "type" : "string",
      "minLength" : 1,
      "description" : "The name of the context to which the state aggregate belongs"
    },
    "aggregateName" : {
      "type" : "string",
      "minLength" : 1,
      "description" : "The name of the aggregate to which the state aggregate belongs"
    },
    "tenantId" : {
      "type" : "string",
      "minLength" : 1,
      "description" : "The tenant id of the aggregate"
    },
    "aggregateId" : {
      "type" : "string",
      "minLength" : 1,
      "description" : "The id of the aggregate"
    },
    "ownerId" : {
      "type" : "string",
      "description" : "The owner ID of the aggregate resource",
      "default" : ""
    },
    "spaceId" : {
      "type" : "string",
      "description" : "The space ID of the aggregate resource",
      "default" : ""
    },
    "version" : {
      "type" : "integer",
      "format" : "int32",
      "description" : "The version of the snapshot"
    },
    "eventId" : {
      "type" : "string",
      "minLength" : 1,
      "description" : "The ID of the domain event stream."
    },
    "firstOperator" : {
      "type" : "string",
      "description" : "The first person who operates the aggregate is the creator"
    },
    "operator" : {
      "type" : "string",
      "description" : "The last person who operates the aggregate"
    },
    "firstEventTime" : {
      "type" : "integer",
      "format" : "int64",
      "description" : "The first event time of the aggregate, which is the time it was created"
    },
    "state" : {
      "type" : "object",
      "properties" : {
        "address" : {
          "$ref" : "#/definitions/wow.schema.TestAddress"
        },
        "id" : {
          "type" : "string"
        },
        "items" : {
          "type" : "array",
          "items" : {
            "$ref" : "#/definitions/wow.schema.TestItem"
          }
        },
        "name" : {
          "type" : "string"
        },
        "nullableField" : {
          "anyOf" : [ {
            "type" : "null"
          }, {
            "type" : "string"
          } ]
        },
        "status" : {
          "$ref" : "#/definitions/wow.schema.TestStatus"
        }
      },
      "required" : [ "id", "name" ],
      "description" : "The state data of the aggregate"
    },
    "tags" : {
      "type" : "object",
      "description" : "The ABAC tags of the aggregate",
      "additionalProperties" : {
        "type" : "array",
        "items" : {
          "type" : "string"
        }
      }
    },
    "deleted" : {
      "type" : "boolean",
      "description" : "Whether the aggregate has been deleted"
    }
  },
  "required" : [ "contextName", "aggregateName", "tenantId", "aggregateId", "ownerId", "spaceId", "version", "eventId", "firstOperator", "operator", "firstEventTime", "state", "deleted" ]
}
