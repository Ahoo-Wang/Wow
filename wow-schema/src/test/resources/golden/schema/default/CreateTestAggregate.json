        },
        "country" : {
          "type" : "string"
        },
        "district" : {
          "type" : "string"
        }
      }
    },
    "wow.schema.TestItem" : {
      "type" : "object",
      "properties" : {
        "price" : {
          "type" : "number"
        },
        "productId" : {
          "type" : "string"
        },
        "quantity" : {
          "type" : "integer",
          "format" : "int32"
        }
      },
      "required" : [ "price", "productId", "quantity" ]
    }
  },
  "type" : "object",
  "properties" : {
