{
  "$schema" : "http://json-schema.org/draft-07/schema#",
  "definitions" : {
    "example.order.OrderItem" : {
      "type" : "object",
      "properties" : {
        "id" : {
          "type" : "string"
        },
        "price" : {
          "type" : "number"
        },
        "productId" : {
          "type" : "string"
        },
        "quantity" : {
          "type" : "integer",
          "format" : "int32"
        },
        "totalPrice" : {
          "type" : "number",
          "readOnly" : true
        }
      },
      "required" : [ "id", "price", "productId", "quantity" ]
    },
    "example.order.OrderStatus" : {
      "type" : "string",
      "enum" : [ "CREATED", "PAID", "SHIPPED", "RECEIVED" ],
      "x-enum-text" : {
        "CREATED" : "已创建",
        "PAID" : "已支付",
        "SHIPPED" : "已发货",
        "RECEIVED" : "已收货"
      }
    },
    "example.order.ShippingAddress" : {
      "type" : "object",
      "properties" : {
        "city" : {
          "type" : "string"
        },
        "country" : {
          "type" : "string",
          "minLength" : 1
        },
        "detail" : {
          "type" : "string"
        },
        "district" : {
          "type" : "string"
        },
        "province" : {
          "type" : "string",
          "minLength" : 1
        }
      },
      "required" : [ "city", "country", "detail", "district", "province" ]
    }
  },
  "type" : "object",
  "properties" : {
    "address" : {
      "allOf" : [ {
        "$ref" : "#/definitions/example.order.ShippingAddress"
      }, {
        "readOnly" : true
      } ]
    },
    "id" : {
      "type" : "string"
    },
    "items" : {
      "readOnly" : true,
      "type" : "array",
      "items" : {
        "allOf" : [ {
          "$ref" : "#/definitions/example.order.OrderItem"
        }, {
          "readOnly" : true
        } ]
      }
    },
    "paidAmount" : {
      "type" : "number"
    },
    "status" : {
      "$ref" : "#/definitions/example.order.OrderStatus"
    },
    "totalAmount" : {
      "type" : "number"
    },
    "payable" : {
      "type" : "number",
      "readOnly" : true
    }
  },
  "required" : [ "id" ]
}
