{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "anyOf" : [ {
    "type" : "object",
    "properties" : {
      "type" : {
        "const" : "default"
      }
    },
    "required" : [ "type" ]
  }, {
    "allOf" : [ {
      "type" : "object",
      "properties" : {
        "type" : {
          "type" : "string",
          "minLength" : 1
        },
        "value" : {
          "type" : "string"
        }
      },
      "required" : [ "value" ]
    }, {
      "type" : "object",
      "properties" : {
        "type" : {
          "const" : "custom"
        }
      },
      "required" : [ "type" ]
    } ]
  } ],
  "properties" : {
    "type" : {
      "type" : "string",
      "minLength" : 1
    }
  }
}
