{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "wow-service",
  "description": "The values of one Wow service. A key not declared here fails the install, as Wow refuses a wow.* key it does not know.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^([a-z]([-a-z0-9]*[a-z0-9])?)?$",
          "maxLength": 55,
          "description": "The service's spring.application.name; every object is named after it (<name>-cluster at most 63 characters). The chart refuses an empty one, naming the values that give it."
        },
        "peers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "context": {
                "type": "string",
                "description": "The peer context."
              },
              "service": {
                "type": "string",
                "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63,
                "description": "The service that hosts it, as its contract names it; absent when the contract names none."
              },
              "namespace": {
                "type": "string",
                "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
                "maxLength": 63,
                "description": "The peer's namespace, when it is not the release's."
              }
            },
            "required": [
              "context"
            ]
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "route": {
              "type": "string",
              "pattern": "^/",
              "description": "Where every node serves the Manifest."
            }
          }
        }
      },
      "required": [
        "name"
      ]
    },
    "ports": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "internal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "required": [
        "http",
        "internal"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[a-f0-9]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "replicas": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "rollout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSurge": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]*%$"
            }
          ]
        }
      }
    },
    "partOf": {
      "type": "string",
      "pattern": "^(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])?$",
      "maxLength": 63
    },
    "config": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "settings": {
      "type": "object"
    },
    "javaOpts": {
      "type": "string"
    },
    "envFrom": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shutdown": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preStopSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "waitMaxTimeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "drainTimeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "subscriptionStopTimeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "marginSeconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "unhealthyPodEvictionPolicy": {
          "enum": [
            "",
            "IfHealthyBudget",
            "AlwaysAllow"
          ]
        }
      }
    },
    "topologySpread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxSkew": {
          "type": "integer",
          "minimum": 1
        },
        "whenUnsatisfiable": {
          "enum": [
            "ScheduleAnyway",
            "DoNotSchedule"
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "public": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "internal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "from": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "publicService": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hpa": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "cpuUtilization": {
              "type": "integer",
              "minimum": 1
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "behavior": {
              "type": "object"
            }
          }
        },
        "keda": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 0
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "pollingInterval": {
              "type": "integer",
              "minimum": 1
            },
            "cooldownPeriod": {
              "type": "integer",
              "minimum": 0
            },
            "prometheus": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "serverAddress": {
                  "type": "string"
                },
                "query": {
                  "type": "string"
                },
                "threshold": {
                  "type": [
                    "integer",
                    "number",
                    "string"
                  ]
                }
              }
            },
            "behavior": {
              "type": "object"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "podMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "automount": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "extraVolumes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraVolumeMounts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "global": {
      "type": "object",
      "description": "Values an umbrella chart passes to every subchart; not read."
    }
  },
  "required": [
    "service",
    "image"
  ]
}
