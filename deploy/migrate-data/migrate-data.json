{
  "map": "migration-map.json",
  "checkpoint": "target:order-service",
  "source": {
    "uri": "env:NINEX_MONGO_URI",
    "database": "order_db"
  },
  "target": {
    "type": "postgres",
    "jdbcUrl": "jdbc:postgresql://postgres:5432/wow",
