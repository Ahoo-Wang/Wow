    "code" : "wow.command.refused",
    "status" : 409,
    "description" : "The aggregate's current state refuses the command (a check of its decide function); the message says why."
  }, {
    "code" : "wow.command.undeclared-event",
    "status" : 500,
    "description" : "The command's handling produced an event its decide function or after hooks do not declare: a bug in the model, which the message names; it committed nothing."
  }, {
    "code" : "wow.node.closing",
    "status" : 503,
    "description" : "The node is shutting down; retry on another node."
  }, {
    "code" : "wow.node.standby",
    "status" : 503,
    "description" : "The node is on standby until the cut-over: it serves reads only."
  }, {
    "code" : "wow.storage.unavailable",
    "status" : 503,
    "description" : "A store could not be reached or did not answer in time; retry later, a command with the same request id."
  }, {
    "code" : "wow.schedule.not-due",
    "status" : 503,
    "description" : "A scheduled command arrived too long before its due time on this node's clock; it is sent again later."
  }, {
    "code" : "wow.schedule.job-invalid",
    "status" : 400,
    "description" : "The job command does not fit its job or instance: an unknown job, another scope, or an instance not enabled."
  }, {
    "code" : "wow.ledger.stale",
    "status" : 409,
    "description" : "The action names a parking the entry no longer is: the aggregate was resolved and parked again since; read the entry again before acting on it."
  }, {
    "code" : "wow.subscription.parked",
    "status" : 500,
    "description" : "A subscription on the wait chain parked the aggregate; the wait cannot be reached until it resumes."
  }, {
    "code" : "wow.wait.timeout",
    "status" : 504,
    "description" : "The wait ran out of time; the command may have committed. The problem carries the last stage reached."
  }, {
    "code" : "wow.route.malformed",
    "status" : 400,
    "description" : "A service route's parameter or body cannot be read as its type; the violation names the parameter."
  }, {
    "code" : "wow.query.malformed",
    "status" : 400,
    "description" : "The query body cannot be read as a query."
  }, {
    "code" : "wow.query.invalid",
    "status" : 400,
    "description" : "The query failed admission; the problem lists the violations, each with its code (UNKNOWN_FIELD, ...)."
  }, {
    "code" : "wow.query.failed",
    "status" : 500,
    "description" : "The query backend failed to run the query."
  }, {
    "code" : "wow.query.not-found",
    "status" : 404,
    "description" : "A single query matched no record: a query result, not a statement that an aggregate does not exist."
  }, {
    "code" : "wow.query.dataset-not-found",
    "status" : 404,
    "description" : "No dataset of that name is served to the caller."
  }, {
    "code" : "wow.query.too-many-groups",
    "status" : 400,
    "description" : "An aggregation that names no sort has more groups than its limit; add a sort for a top-N, or raise limit."
  }, {
    "code" : "wow.query.timeout",
    "status" : 504,
    "description" : "The query ran longer than its budget allows; narrow it rather than run it again."
  }, {
    "code" : "wow.query.min-version-not-reached",
    "status" : 409,
    "description" : "The state read asked for a version the aggregate has not reached within the wait; the problem carries its current version: retry later."
  }, {
    "code" : "wow.query.busy",
    "status" : 429,
    "description" : "The query was not run: its store has as many queries running as it allows; retry later."
  }, {
    "code" : "wow.query.dataset-unavailable",
    "status" : 409,
    "description" : "The dataset is served but cannot be queried now, for the reason the problem names (it needs revision)."
  }, {
    "code" : "wow.call.command-forbidden",
    "status" : 403,
    "description" : "The calling service may not call this command: its wow.callers.<service>.commands do not list it."
  } ],
