{
  // Stories are consumers of the packages, so they are checked against the
  // packages' built declarations, as an application sees them. Build the
  // packages first: pnpm build:typescript
  "compilerOptions": {
    // Vite reads the nearest tsconfig when it transforms a story, so the
    // options that change emitted code stay as the root sets them.
    "target": "ES2020",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      // The alias .storybook/main.ts gives the compensation console: View
      // Engine's vendored primitives, which the package does not export.
      "@/ui/*": ["../../wow-view-engine/src/ui/*"]
    }
  },
  "include": [
    "**/*",
    "../.storybook/DocsPage.tsx",
    "../.storybook/manager.ts",
    "../.storybook/preview.tsx",
    "../.storybook/vitest.setup.ts"
  ]
}
