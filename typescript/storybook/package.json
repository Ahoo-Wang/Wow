{
  "name": "wow-storybook",
  "version": "9.1.5",
  "private": true,
  "description": "Storybook for the Wow TypeScript packages: view-engine and the Wow query hooks, with interaction tests",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build --docs && node scripts/verify-storybook.mjs",
    "build:site": "storybook build --docs -o ../../documentation/docs/.vitepress/dist/storybook && node scripts/verify-storybook.mjs ../../documentation/docs/.vitepress/dist/storybook/index.json",
    "test": "vitest run --project=storybook --project=unit",
    "typecheck": "tsc -p stories/tsconfig.json",
    "lint": "eslint stories .storybook scripts --max-warnings 0"
  },
  "devDependencies": {
    "@ahoo-wang/fetcher": "catalog:",
    "@ahoo-wang/fetcher-decorator": "catalog:",
    "@ahoo-wang/fetcher-eventstream": "catalog:",
    "@ahoo-wang/fetcher-react": "catalog:",
    "@ahoo-wang/wow-client": "workspace:*",
    "@ahoo-wang/wow-react": "workspace:*",
    "@ahoo-wang/wow-view-engine": "workspace:*",
    "antd": "catalog:",
    "@chromatic-com/storybook": "catalog:",
    "culori": "catalog:",
    "dayjs": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "@eslint/js": "catalog:",
    "globals": "catalog:",
    "lucide-react": "catalog:",
    "mingo": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-themes": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "tailwindcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/culori": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:"
  }
}
