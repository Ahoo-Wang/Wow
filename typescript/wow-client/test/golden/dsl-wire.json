  "aggregation.query (full)": {
    "elements": [
      {
        "filter": {
          "field": "quantity",
          "op": "GT",
          "value": 0
        },
        "path": "state.items"
      }
    ],
    "filter": {
      "field": "state.status",
      "op": "EQ",
      "value": "PAID"
    },
    "groupBy": [
      {
        "alias": "sku",
        "field": "state.items.sku",
        "type": "TERMS"
      },
      {
        "alias": "day",
        "field": "state.createTime",
        "timeZone": "Asia/Shanghai",
        "type": "DATE_HISTOGRAM",
        "unit": "DAY"
      }
    ],
    "having": {
      "operands": [
        {
          "metric": "orders",
          "operator": "GT",
          "type": "CONDITION",
          "value": 1
        },
        {
          "lower": 10,
          "metric": "revenue",
          "type": "BETWEEN",
          "upper": 1000
        },
        {
          "metric": "orders",
          "type": "IN",
          "values": [
            2,
            3
          ]
        },
        {
          "metric": "aov",
          "negated": true,
          "type": "IS_NULL"
        }
      ],
      "type": "AND"
    },
    "limit": 50,
    "metrics": [
      {
        "alias": "orders",
        "type": "COUNT"
      },
      {
        "alias": "revenue",
        "expression": {
          "field": "state.items.price",
          "type": "FIELD"
        },
        "function": "SUM",
        "type": "NUMERIC"
      },
      {
        "alias": "aov",
        "expression": {
          "left": {
            "metric": "revenue",
            "type": "METRIC_REF"
          },
          "operator": "DIVIDE",
          "right": {
            "metric": "orders",
            "type": "METRIC_REF"
          },
          "type": "BINARY"
        },
        "type": "DERIVED"
      }
    ],
    "sort": [
      {
        "direction": "DESC",
        "field": "revenue"
      },
      {
        "direction": "ASC",
        "field": "sku"
      }
    ]
  },
