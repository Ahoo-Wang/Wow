{
  "name": "@ahoo-wang/wow-client",
  "version": "10.0.0-alpha.4",
  "description": "TypeScript client for Wow (https://github.com/Ahoo-Wang/Wow): commands with their waits and event streams, state reads, snapshot, event and dataset queries, the Manifest and RFC 9457 problems, and the query DSL, built on Fetcher.",
  "keywords": [
    "wow",
    "wow-client",
    "cqrs",
    "event-sourcing",
    "ddd",
    "microservice",
    "typescript",
    "fetch",
    "http",
    "client"
  ],
  "author": "Ahoo-Wang",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Ahoo-Wang/Wow/tree/main/typescript/wow-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahoo-Wang/Wow.git",
    "directory": "typescript/wow-client"
  },
  "bugs": {
    "url": "https://github.com/Ahoo-Wang/Wow/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./dsl": {
      "import": {
        "types": "./dist/dsl.d.ts",
        "default": "./dist/dsl.es.js"
      },
      "require": {
        "types": "./dist/dsl.d.cts",
        "default": "./dist/dsl.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && pnpm test:package",
    "test:package": "node scripts/verify-package.mjs",
    "test:ui": "vitest --ui",
    "test": "vitest run --coverage && pnpm test:type && pnpm test:api",
    "test:api": "node scripts/api-report.mjs",
    "test:type": "tsc --noEmit -p test/tsconfig.types.json",
    "lint": "eslint . --fix",
    "clean": "rm -rf dist",
    "analyze": "npx vite-bundle-analyzer -p auto",
    "test:no-coverage": "vitest run --coverage.enabled=false && pnpm test:type && pnpm test:api"
  },
  "peerDependencies": {
    "@ahoo-wang/fetcher": "catalog:peers",
    "@ahoo-wang/fetcher-eventstream": "catalog:peers"
  },
  "devDependencies": {
    "@ahoo-wang/fetcher": "catalog:",
    "@ahoo-wang/fetcher-eventstream": "catalog:",
    "@eslint/js": "catalog:",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "catalog:",
    "vitest": "catalog:"
  }
}
