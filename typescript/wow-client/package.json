{
  "name": "@ahoo-wang/wow-client",
  "version": "9.1.5",
  "description": "TypeScript client for Wow (https://github.com/Ahoo-Wang/Wow): commands, snapshot and event-stream queries, and the query DSL, built on Fetcher.",
  "keywords": [
    "fetch",
    "http",
    "client",
    "wow",
    "cqrs",
    "ddd",
    "microservice",
    "event-sourcing"
  ],
  "author": "Ahoo-Wang",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Ahoo-Wang/Wow/tree/main/typescript/wow-client",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahoo-Wang/Wow.git",
    "directory": "typescript/wow-client"
  },
  "bugs": {
    "url": "https://github.com/Ahoo-Wang/Wow/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./query/locale/zh_CN": {
      "import": {
        "types": "./dist/query/locale/zh_CN.d.ts",
        "default": "./dist/query/locale/zh_CN.es.js"
      },
      "require": {
        "types": "./dist/query/locale/zh_CN.d.cts",
        "default": "./dist/query/locale/zh_CN.cjs"
      }
    },
    "./query/locale/en_US": {
      "import": {
        "types": "./dist/query/locale/en_US.d.ts",
        "default": "./dist/query/locale/en_US.es.js"
      },
      "require": {
        "types": "./dist/query/locale/en_US.d.cts",
        "default": "./dist/query/locale/en_US.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "test:ui": "vitest --ui",
    "test": "vitest run --coverage && pnpm test:type",
    "test:type": "tsc --noEmit -p test/tsconfig.types.json",
    "lint": "eslint . --fix",
    "clean": "rm -rf dist",
    "analyze": "npx vite-bundle-analyzer -p auto",
    "test:no-coverage": "vitest run --coverage.enabled=false && pnpm test:type"
  },
  "peerDependencies": {
    "@ahoo-wang/fetcher": "catalog:peers",
    "@ahoo-wang/fetcher-decorator": "catalog:peers",
    "@ahoo-wang/fetcher-eventstream": "catalog:peers"
  },
  "devDependencies": {
    "@ahoo-wang/fetcher": "catalog:",
    "@ahoo-wang/fetcher-decorator": "catalog:",
    "@ahoo-wang/fetcher-eventstream": "catalog:",
    "@eslint/js": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "catalog:",
    "vitest": "catalog:"
  }
}
