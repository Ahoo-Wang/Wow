{
  "name": "@ahoo-wang/wow-generator",
  "version": "9.1.5",
  "description": "Generates TypeScript models, Fetcher decorator clients and Wow command and query clients from a local or remote OpenAPI 3 document. The Wow clients follow the CQRS model of the Wow DDD framework (https://github.com/Ahoo-Wang/Wow).",
  "keywords": [
    "wow",
    "wow-generator",
    "cqrs",
    "ddd",
    "openapi",
    "openapi3",
    "swagger",
    "generator",
    "codegen",
    "typescript",
    "api",
    "client",
    "rest",
    "fetch",
    "http"
  ],
  "author": "Ahoo-Wang",
  "license": "Apache-2.0",
  "homepage": "https://wow.ahoo.me/reference/typescript/wow-generator/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahoo-Wang/Wow.git",
    "directory": "typescript/wow-generator"
  },
  "bugs": {
    "url": "https://github.com/Ahoo-Wang/Wow/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "wow-generator": "./dist/cli.js",
    "fetcher-generator": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && pnpm test:package",
    "test:package": "node scripts/verify-package.mjs",
    "test:ui": "vitest --ui",
    "test": "vitest run --coverage --testTimeout=15000 && pnpm test:type",
    "test:type": "tsc --noEmit -p test/tsconfig.types.json",
    "lint": "eslint . --fix",
    "clean": "rm -rf dist",
    "analyze": "npx vite-bundle-analyzer -p auto",
    "generate": "node dist/cli.js generate -i test/demo.spec.json -o test-output -t tsconfig.json",
    "test:no-coverage": "vitest run --coverage.enabled=false --testTimeout=15000 && pnpm test:type",
    "bench": "node scripts/bench.mjs"
  },
  "peerDependencies": {
    "@ahoo-wang/fetcher": "catalog:peers",
    "@ahoo-wang/fetcher-decorator": "catalog:peers",
    "@ahoo-wang/fetcher-eventstream": "catalog:peers",
    "@ahoo-wang/fetcher-openapi": "catalog:peers",
    "@ahoo-wang/wow-client": "workspace:~"
  },
  "dependencies": {
    "ts-morph": "catalog:",
    "commander": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@ahoo-wang/fetcher": "catalog:",
    "@ahoo-wang/fetcher-decorator": "catalog:",
    "@ahoo-wang/fetcher-eventstream": "catalog:",
    "@ahoo-wang/fetcher-openapi": "catalog:",
    "@ahoo-wang/wow-client": "workspace:~",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "unplugin-dts": "catalog:",
    "vite": "catalog:",
    "vite-bundle-analyzer": "catalog:",
    "vitest": "catalog:"
  }
}
