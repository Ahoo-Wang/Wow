            {
              "name": "OrderShipped",
              "aliases": [],
              "revision": 1,
              "schema": "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.OrderShipped",
              "description": "The order was shipped"
            },
            {
              "name": "OrderStockConfirmed",
              "aliases": [],
              "revision": 1,
              "schema": "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.OrderStockConfirmed",
              "description": "The inventory reserved every product of the order; it awaits its payment"
