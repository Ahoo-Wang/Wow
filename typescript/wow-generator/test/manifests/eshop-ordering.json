              "schema": "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.OrderAwaitingValidation",
              "description": "The order awaits its stock validation"
            },
            {
              "name": "OrderCancelled",
              "aliases": [],
              "revision": 1,
              "schema": "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.OrderCancelled",
