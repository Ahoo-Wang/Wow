              "creation": "required",
              "produces": ["OrderSubmitted"],
              "routes": [
                {
                  "method": "POST",
                  "path": "/eshop-ordering/order/{id}/submit-order"
                },
                {
                  "method": "POST",
                  "path": "/eshop-ordering/order/submit-order"
                }
              ],
              "description": "Submit an order"
            },
            {
              "name": "wow.lifecycle.ApplyTags",
              "aliases": [],
              "schema": "#/$defs/wow.lifecycle.ApplyTags",
              "creation": "none",
              "routes": [
                {
                  "method": "POST",
                  "path": "/eshop-ordering/order/{id}/wow.lifecycle.apply-tags"
