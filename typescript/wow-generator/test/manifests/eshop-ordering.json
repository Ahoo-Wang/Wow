    },
    "me.ahoo.wow.example.eshop.inventory.api.stock.ReleaseReservation": {
      "type": "object",
      "properties": { "orderId": { "type": "string" } },
      "required": ["orderId"],
      "description": "Release an order's reservation"
    },
    "me.ahoo.wow.example.eshop.inventory.api.stock.ReserveStock": {
      "type": "object",
      "properties": {
        "orderId": { "type": "string" },
        "quantity": { "type": "integer" }
      },
      "required": ["orderId", "quantity"],
      "description": "Reserve stock for an order"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.AwaitStockValidation": {
      "type": "object",
      "description": "Await the stock validation"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.CancelOrder": {
      "type": "object",
      "properties": { "reason": { "type": "string" } },
      "required": ["reason"],
      "description": "Cancel the order"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.ConfirmOrderStock": {
      "type": "object",
      "properties": { "productId": { "type": "string" } },
      "required": ["productId"],
      "description": "Confirm a product's stock"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderAwaitingValidation": {
      "type": "object",
      "description": "The order awaits its stock validation"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderCancelled": {
      "type": "object",
      "properties": { "reason": { "type": "string" } },
      "required": ["reason"],
      "description": "The order was cancelled"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderItem": {
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "integer" },
        "unitPrice": { "type": "number", "format": "decimal" }
      },
      "required": ["productId", "quantity", "unitPrice"]
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderPaid": {
      "type": "object",
      "properties": {
        "amount": { "type": "number", "format": "decimal" },
        "paymentId": { "type": "string" }
      },
      "required": ["amount", "paymentId"],
      "description": "The order was paid"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderShipped": {
      "type": "object",
      "description": "The order was shipped"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderStockConfirmed": {
      "type": "object",
      "description": "The inventory reserved every product of the order; it awaits its payment"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderStockItemConfirmed": {
      "type": "object",
      "properties": { "productId": { "type": "string" } },
      "required": ["productId"],
      "description": "The inventory reserved one of the order's products"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.OrderSubmitted": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.OrderItem"
          }
        }
      },
      "required": ["items"],
      "description": "An order was submitted"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.PayOrder": {
      "type": "object",
      "properties": {
        "amount": { "type": "number", "format": "decimal" },
        "paymentId": { "type": "string" }
      },
      "required": ["amount", "paymentId"],
      "description": "Pay the order"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.ShipOrder": {
      "type": "object",
      "description": "Ship the order"
    },
    "me.ahoo.wow.example.eshop.ordering.api.order.SubmitOrder": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.OrderItem"
          }
        }
      },
      "required": ["items"],
      "description": "Submit an order"
    },
    "me.ahoo.wow.example.eshop.ordering.domain.order.OrderState": {
      "type": "object",
      "properties": {
        "cancelReason": { "type": ["string", "null"] },
        "confirmedProducts": { "type": "array", "items": { "type": "string" } },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.OrderItem"
          }
        },
        "paymentId": { "type": ["string", "null"] },
        "status": {
          "type": "string",
          "enum": [
            "SUBMITTED",
            "AWAITING_VALIDATION",
            "STOCK_CONFIRMED",
            "PAID",
            "SHIPPED",
            "CANCELLED"
          ]
        },
        "totalAmount": { "type": "number", "format": "decimal" }
      },
      "required": ["confirmedProducts", "items", "status", "totalAmount"]
    },
    "wow.lifecycle.ApplyTags": {
      "type": "object",
      "properties": {
        "tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "required": ["tags"],
      "description": "Sets the aggregate's tags, replacing the ones it had; empty tags clear them."
    },
    "wow.lifecycle.DeleteAggregate": {
      "type": "object",
      "description": "Marks the aggregate deleted; its events stay in the log."
    },
    "wow.lifecycle.RestoreAggregate": {
      "type": "object",
      "description": "Takes back the deletion of a deleted aggregate."
    },
    "wow.lifecycle.TransferOwner": {
      "type": "object",
      "properties": { "ownerId": { "type": "string" } },
      "required": ["ownerId"],
      "description": "Gives the aggregate to the owner ownerId."
    },
    "wow.lifecycle.TransferSpace": {
      "type": "object",
      "properties": { "spaceId": { "type": "string" } },
      "required": ["spaceId"],
      "description": "Moves the aggregate to the space spaceId."
    },
    "wow.snapshot.Rebuild": {
      "type": "object",
      "properties": {
        "ids": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["ids"]
    }
  }
}
