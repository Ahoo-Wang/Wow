              "schema": "#/$defs/wow.lifecycle.RestoreAggregate",
              "creation": "none",
              "routes": [
                {
                  "method": "POST",
                  "path": "/eshop-ordering/order/{id}/wow.lifecycle.restore-aggregate"
                }
              ],
              "system": true
            },
            {
              "name": "wow.lifecycle.TransferOwner",
              "aliases": [],
              "schema": "#/$defs/wow.lifecycle.TransferOwner",
              "creation": "none",
              "routes": [
                {
                  "method": "POST",
                  "path": "/eshop-ordering/order/{id}/wow.lifecycle.transfer-owner"
