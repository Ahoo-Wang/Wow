                {
                  "method": "GET",
                  "path": "/eshop-ordering/order/events/query"
                }
              ]
            }
          ],
          "schedules": ["eshop-ordering.order.CancelOrder"]
        }
      ],
      "subscriptions": [
        {
          "name": "OrderProcessSaga.onOrderAwaitingValidation",
          "kind": "saga",
          "source": {
            "context": "eshop-ordering",
            "aggregates": ["order"],
            "events": []
          },
          "function": {
            "kind": "saga",
            "context": "eshop-ordering",
            "processor": "OrderProcessSaga",
            "name": "onOrderAwaitingValidation"
          },
          "derives": [
            "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReserveStock"
          ],
          "start": "end"
        },
        {
          "name": "OrderProcessSaga.onOrderCancelled",
          "kind": "saga",
          "source": {
            "context": "eshop-ordering",
            "aggregates": ["order"],
            "events": []
          },
          "function": {
            "kind": "saga",
            "context": "eshop-ordering",
            "processor": "OrderProcessSaga",
            "name": "onOrderCancelled"
          },
          "derives": [
            "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReleaseReservation"
          ],
          "start": "end"
        },
        {
          "name": "OrderProcessSaga.onOrderShipped",
          "kind": "saga",
          "source": {
            "context": "eshop-ordering",
            "aggregates": ["order"],
            "events": []
          },
          "function": {
            "kind": "saga",
            "context": "eshop-ordering",
            "processor": "OrderProcessSaga",
            "name": "onOrderShipped"
          },
          "derives": [
            "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.CommitReservation"
          ],
          "start": "end"
        },
        {
          "name": "OrderProcessSaga.onOrderSubmitted",
          "kind": "saga",
          "source": {
            "context": "eshop-ordering",
            "aggregates": ["order"],
            "events": []
          },
          "function": {
            "kind": "saga",
            "context": "eshop-ordering",
            "processor": "OrderProcessSaga",
            "name": "onOrderSubmitted"
          },
          "derives": ["eshop-ordering.order.AwaitStockValidation"],
          "start": "end"
        },
        {
          "name": "OrderProcessSaga.onReleaseRejected",
          "kind": "saga",
          "source": { "aggregates": [], "events": [] },
          "function": {
            "kind": "saga",
            "context": "eshop-ordering",
            "processor": "OrderProcessSaga",
            "name": "onReleaseRejected"
          },
          "derives": ["eshop-ordering.order.CancelOrder"],
          "rejected": [
            "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReleaseReservation"
          ]
        },
        {
          "name": "OrderProcessSaga.onReserveCommitted",
          "kind": "saga",
          "source": { "aggregates": [], "events": [] },
          "function": {
            "kind": "saga",
            "context": "eshop-ordering",
            "processor": "OrderProcessSaga",
            "name": "onReserveCommitted"
          },
          "derives": ["eshop-ordering.order.ConfirmOrderStock"],
          "committed": [
            "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReserveStock"
          ]
        },
        {
          "name": "OrderProcessSaga.onReserveRejected",
          "kind": "saga",
          "source": { "aggregates": [], "events": [] },
          "function": {
            "kind": "saga",
            "context": "eshop-ordering",
            "processor": "OrderProcessSaga",
            "name": "onReserveRejected"
          },
          "derives": ["eshop-ordering.order.CancelOrder"],
          "rejected": [
            "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReserveStock"
          ]
        }
      ],
      "published": [
        {
          "aggregate": "order",
          "topic": "wow.eshop-ordering.order.state",
          "includeState": true
        }
      ],
      "errors": [
        {
          "code": "eshop-ordering.order.invalid-items",
          "status": 422,
          "description": "An order has at least one item, each of a positive quantity and a price not negative."
        },
        {
          "code": "eshop-ordering.order.wrong-amount",
          "status": 422,
          "description": "A payment pays the order's total amount."
        },
        {
          "code": "eshop-ordering.order.wrong-status",
          "status": 409,
          "description": "The order's status does not allow the command."
        }
      ]
    }
  ],
  "errors": [
    {
      "code": "wow.auth.unauthenticated",
      "status": 401,
      "description": "The request carries no valid credentials."
    },
    {
