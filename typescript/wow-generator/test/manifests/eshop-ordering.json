              "system": true
            },
            {
              "name": "wow.lifecycle.TransferSpace",
              "aliases": [],
              "schema": "#/$defs/wow.lifecycle.TransferSpace",
              "creation": "none",
              "routes": [
                {
                  "method": "POST",
                  "path": "/eshop-ordering/order/{id}/wow.lifecycle.transfer-space"
                }
