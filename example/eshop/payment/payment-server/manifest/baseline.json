        "name" : "PaymentRefunded",
        "aliases" : [ ],
        "revision" : 1,
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.payment.api.payment.PaymentRefunded",
        "description" : "A payment was refunded"
      }, {
        "name" : "PaymentRequested",
        "aliases" : [ ],
        "revision" : 1,
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.payment.api.payment.PaymentRequested",
        "description" : "A payment was requested"
      }, {
        "name" : "PaymentSucceeded",
        "aliases" : [ ],
        "revision" : 1,
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.payment.api.payment.PaymentSucceeded",
        "description" : "The gateway approved a payment"
      } ],
      "lifecycle" : [ "wow.lifecycle.ApplyTags", "wow.lifecycle.DeleteAggregate", "wow.lifecycle.RestoreAggregate", "wow.lifecycle.TransferOwner", "wow.lifecycle.TransferSpace" ],
