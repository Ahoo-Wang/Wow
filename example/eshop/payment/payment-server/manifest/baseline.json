      "derives" : [ "eshop-payment.payment.RefundPayment" ],
      "rejected" : [ "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.PayOrder" ]
    }, {
      "name" : "OrderPaymentSaga.onPaymentFailed",
      "kind" : "SAGA",
      "source" : {
        "context" : "eshop-payment",
        "aggregates" : [ "payment" ],
        "events" : [ "PaymentFailed" ]
      },
      "function" : {
        "kind" : "SAGA",
        "context" : "eshop-payment",
        "processor" : "OrderPaymentSaga",
        "name" : "onPaymentFailed"
      },
      "derives" : [ "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.CancelOrder" ],
      "start" : "END"
    }, {
      "name" : "OrderPaymentSaga.onPaymentSucceeded",
      "kind" : "SAGA",
      "source" : {
        "context" : "eshop-payment",
        "aggregates" : [ "payment" ],
        "events" : [ "PaymentSucceeded" ]
      },
      "function" : {
        "kind" : "SAGA",
        "context" : "eshop-payment",
        "processor" : "OrderPaymentSaga",
        "name" : "onPaymentSucceeded"
      },
      "derives" : [ "#/$defs/me.ahoo.wow.example.eshop.ordering.api.order.PayOrder" ],
      "start" : "END"
    }, {
      "name" : "PaymentGatewaySaga.onPaymentRequested",
      "kind" : "SAGA",
      "source" : {
        "context" : "eshop-payment",
        "aggregates" : [ "payment" ],
        "events" : [ "PaymentRequested" ]
      },
      "function" : {
        "kind" : "SAGA",
        "context" : "eshop-payment",
        "processor" : "PaymentGatewaySaga",
        "name" : "onPaymentRequested"
      },
      "derives" : [ "eshop-payment.payment.ConfirmPayment", "eshop-payment.payment.FailPayment" ],
      "start" : "END"
    } ],
    "published" : [ {
      "aggregate" : "payment",
      "topic" : "wow.eshop-payment.payment.state",
      "includeState" : true
    } ],
