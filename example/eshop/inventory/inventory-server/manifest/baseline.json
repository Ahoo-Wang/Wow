        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.domain.stock.StockState",
        "fingerprint" : "45816edb89ab34cb0635421726207356873b7c06bee85a566ac990b012b702d5"
      },
      "snapshot" : {
        "enabled" : true
      },
      "commands" : [ {
        "name" : "CommitReservation",
        "aliases" : [ ],
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.CommitReservation",
        "creation" : "NONE",
        "produces" : [ "ReservationCommitted" ],
        "routes" : [ {
          "method" : "POST",
          "path" : "/eshop-inventory/stock/{id}/commit-reservation"
        } ],
        "description" : "Commit an order's reservation"
      }, {
        "name" : "ReceiveStock",
        "aliases" : [ ],
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReceiveStock",
        "creation" : "ALLOWED",
        "produces" : [ "StockReceived" ],
        "routes" : [ {
          "method" : "POST",
          "path" : "/eshop-inventory/stock/{id}/receive-stock"
        }, {
          "method" : "POST",
          "path" : "/eshop-inventory/stock/receive-stock"
        } ],
        "description" : "Receive stock"
      }, {
        "name" : "ReleaseReservation",
        "aliases" : [ ],
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReleaseReservation",
