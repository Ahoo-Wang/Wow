        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReservationReleased",
        "description" : "An order's reservation was released"
      }, {
        "name" : "StockReceived",
        "aliases" : [ ],
        "revision" : 1,
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.StockReceived",
        "description" : "Stock was received"
      }, {
        "name" : "StockReserved",
        "aliases" : [ ],
        "revision" : 1,
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.StockReserved",
        "description" : "Stock was reserved for an order"
      } ],
      "lifecycle" : [ "wow.lifecycle.ApplyTags", "wow.lifecycle.DeleteAggregate", "wow.lifecycle.RestoreAggregate", "wow.lifecycle.TransferSpace" ],
      "queries" : [ {
        "model" : "snapshot",
        "routes" : [ {
          "method" : "POST",
          "path" : "/eshop-inventory/stock/snapshot/query"
        }, {
          "method" : "GET",
          "path" : "/eshop-inventory/stock/snapshot/query"
        } ]
      }, {
        "model" : "events",
        "routes" : [ {
          "method" : "POST",
          "path" : "/eshop-inventory/stock/events/query"
        }, {
          "method" : "GET",
          "path" : "/eshop-inventory/stock/events/query"
        } ]
      } ],
      "ownership" : "TENANT"
    } ],
    "subscriptions" : [ {
      "name" : "SupplierDeliverySaga.onSchedule",
      "kind" : "SAGA",
      "source" : {
        "context" : "eshop-inventory",
        "aggregates" : [ "schedule" ],
        "events" : [ ]
      },
      "function" : {
        "kind" : "SAGA",
        "context" : "eshop-inventory",
        "processor" : "SupplierDeliverySaga",
        "name" : "onSchedule"
      },
      "start" : "END",
      "job" : {
        "name" : "receive-deliveries",
        "cron" : "0 0 6 * * *",
        "zone" : "UTC",
        "scope" : "SYSTEM",
        "sharded" : false,
        "misfire" : "COALESCE"
      }
    } ],
    "published" : [ {
      "aggregate" : "stock",
      "topic" : "wow.eshop-inventory.stock.state",
      "includeState" : true
    } ],
    "errors" : [ {
      "code" : "eshop-inventory.stock.insufficient",
      "status" : 409,
      "description" : "Fewer units are available than the order asks for."
    }, {
      "code" : "eshop-inventory.stock.no-reservation",
      "status" : 409,
      "description" : "Nothing is reserved for the order."
    } ]
  } ],
