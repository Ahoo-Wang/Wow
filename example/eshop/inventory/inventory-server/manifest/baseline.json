        "routes" : [ {
          "method" : "POST",
          "path" : "/eshop-inventory/stock/{id}/release-reservation"
        } ],
        "description" : "Release an order's reservation"
      }, {
        "name" : "ReserveStock",
        "aliases" : [ ],
        "schema" : "#/$defs/me.ahoo.wow.example.eshop.inventory.api.stock.ReserveStock",
        "creation" : "NONE",
        "produces" : [ "StockReserved" ],
