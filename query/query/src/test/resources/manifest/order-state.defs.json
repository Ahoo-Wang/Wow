      "tip" : {
        "type" : "number",
        "x-wow-money" : {
          "currency" : "JPY",
          "scale" : 1
        }
      },
      "token" : {
        "type" : "string",
        "x-wow-sensitive" : {
          "level" : "confidential"
        },
        "x-wow-mask" : {
          "keepPrefix" : 0,
          "keepSuffix" : 0
        }
      },
      "total" : {
        "type" : "number",
        "x-wow-money" : {
          "currency" : "CNY"
        }
      }
    },
    "required" : [ "address", "backupPhone", "buyer", "buyerId", "createdAt", "currency", "lines", "note", "paid", "password", "phone", "placedAt", "productIds", "rate", "timeout", "tip", "token", "total" ]
